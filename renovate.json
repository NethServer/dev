{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:base"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "Merge GitHub Actions updates automatically",
      "matchManagers": ["github-actions"],
      "automerge": true
    }
  ]
}
